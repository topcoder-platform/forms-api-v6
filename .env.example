# Local development only. Use separate service/migration credentials in deployed environments.
DATABASE_URL=postgresql://forms:forms_local@127.0.0.1:5546/forms
PORT=3006
CORS_ORIGINS=http://localhost:3000,http://localhost:3006

# Local demo token verification. Deployment: AUTH_MODE=jwks and a trusted HTTPS JWKS URL.
AUTH_MODE=hs256
AUTH_SECRET=local-development-only-change-this-secret-000000
VALID_ISSUERS=https://api.topcoder-dev.com
AUTH_AUDIENCE=forms-api
AUTH_CLAIM_NAMESPACE=https://topcoder.com/
# JWKS_URL=https://topcoder-dev.auth0.com/.well-known/jwks.json

# Requests per client IP per minute, per API replica. Shared enforcement belongs at the gateway.
THROTTLE_LIMIT=30
# Empty means X-Forwarded-For is untrusted. List only your actual ingress proxy CIDRs.
TRUST_PROXY_CIDRS=

# Local Docker Compose host ports.
FORMS_HTTP_PORT=3006
FORMS_DATABASE_PORT=5546
