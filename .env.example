# Local development only. Dev deployment uses the provided forms schema-owner login.
DATABASE_URL=postgresql://forms:forms_local@127.0.0.1:5546/forms?schema=forms
PORT=3006
CORS_ORIGINS=http://localhost:3000,http://localhost:3006

# Shared Topcoder JWT authentication: HS256 secret and RS256 issuer-derived JWKS.
AUTH_SECRET=local-development-only-change-this-secret-000000
VALID_ISSUERS=https://api.topcoder-dev.com,https://auth.topcoder-dev.com/,https://topcoder-dev.auth0.com/

# Requests per client IP per minute, per API replica. Shared enforcement belongs at the gateway.
THROTTLE_LIMIT=30
# Empty means X-Forwarded-For is untrusted. List only your actual ingress proxy CIDRs.
TRUST_PROXY_CIDRS=

# Local Docker Compose host ports.
FORMS_HTTP_PORT=3006
FORMS_DATABASE_PORT=5546

# Optional outbound Kafka publication through Bus API (required for kafka=true submissions).
# The wrapper adds /bus/events; use the API base ending in /v6.
# BUSAPI_URL=https://api.topcoder-dev.com/v6
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# TOKEN_CACHE_TIME=86400000
# KAFKA_ERROR_TOPIC=common.error.reporting

# Explicit Keycloak trust for this migration branch only. Member sessions remain Auth0.
M2M_PROVIDER=keycloak
KEYCLOAK_ISSUER=https://keycloak.topcoder-dev.com/realms/topcoder-m2m-dev
KEYCLOAK_AUDIENCE=https://api.topcoder-dev.com
KEYCLOAK_TOKEN_URL=https://keycloak.topcoder-dev.com/m2m/token
# Or supply AUTH_USER_AUDIENCES as a JSON array of approved member audiences.
ALLOW_LEGACY_USER_AUDIENCE=true
