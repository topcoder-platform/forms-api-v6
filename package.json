{
  "name": "@topcoder/forms-api-v6",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned Topcoder forms with typed relational submissions and SQL reporting",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write . --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "start:dev": "node --watch --require ts-node/register src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.11",
    "@types/express": "5.0.6",
    "@types/node": "26.0.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "payload": "3.87.1",
    "prettier": "3.8.1",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "unplugin-swc": "1.5.9",
    "vitest": "4.0.18"
  }
}
